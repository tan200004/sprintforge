NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/sprintforge

# JWT
JWT_ACCESS_SECRET=sprintforge_access_jwt_super_secret_key_2024_do_not_share
JWT_REFRESH_SECRET=sprintforge_refresh_jwt_super_secret_key_2024_do_not_share
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (Nodemailer - update with real SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=SprintForge <no-reply@sprintforge.io>

# Frontend URL (for email links)
CLIENT_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
